{
  "name": "nuxt-oidc-auth-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Docs for nuxt-oidc-auth",
  "type": "module",
  "scripts": {
    "build": "pnpm generate",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "lint": "oxlint -c ../oxlint.config.ts . && eslint --max-warnings 1 \"**/*.vue\"",
    "preview": "nuxi preview",
    "smoke": "pnpm exec playwright test --config playwright.config.ts",
    "typecheck": "nuxi typecheck --checker=vue-tsc",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/content": "^3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.4",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/seo": "^5.3.12",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "nuxt-vitalizer": "^3.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@visorian/code-standards": "0.5.3",
    "eslint": "^10.11.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "authors": "itpropro"
}

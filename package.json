{
  "name": "nuxt-oidc-auth",
  "version": "1.0.0-beta.12",
  "private": false,
  "description": "OIDC authentication module for Nuxt SSR",
  "homepage": "https://github.com/itpropro/nuxt-oidc-auth#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itpropro/nuxt-oidc-auth.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json",
    "./runtime/*": "./dist/runtime/*"
  },
  "scripts": {
    "prepack": "nuxt-module-build build && pnpm test:types:dist && pnpm client:build",
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "dev:client": "concurrently \"nuxi dev client --port 3300\" \"nuxi dev playground\"",
    "dev": "nuxi dev playground",
    "dev:docs": "nuxi dev docs",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare client",
    "release:prepare": "node scripts/release.ts prepare",
    "release:tag": "node scripts/release.ts tag",
    "release:publish": "node scripts/release.ts publish",
    "lint": "pnpm lint:ox && pnpm lint:eslint",
    "lint:ox": "oxlint -c oxlint.json --type-aware --tsconfig tsconfig.json --report-unused-disable-directives .",
    "lint:eslint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache --no-error-on-unmatched-pattern \"**/*.vue\"",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck --checker=golar",
    "client:typecheck": "nuxi typecheck client --checker=golar",
    "test": "vitest run --config test/vitest.config.ts --root .",
    "test:watch": "vitest watch --config test/vitest.config.ts --root .",
    "test:unit": "vitest run --config test/vitest.config.ts --root . test/unit/",
    "test:functional": "vitest run --config test/vitest.config.ts --root . test/functional/",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:keycloak": "test/fixtures/keycloak/test.sh",
    "test:e2e:providers": "playwright test --config playwright.config.ts --project=providers --no-deps",
    "test:e2e:providers:secrets": "secretspec run --profile default --provider e2e -- pnpm test:e2e:providers",
    "test:e2e:secrets": "secretspec run --profile default --provider e2e -- pnpm test:e2e",
    "test:types:dist": "tsc -p test/fixtures/publicTypes/tsconfig.json --noEmit",
    "test:check-env": "npx tsx test/setup/env-validator.ts --check"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "hookable": "^6.1.1",
    "jose": "^6.2.9",
    "ofetch": "^1.5.1",
    "sirv": "^3.0.2",
    "ufo": "^1.6.4",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@golar/vue": "^0.1.10",
    "@nuxt/devtools": "3.4.0",
    "@nuxt/devtools-ui-kit": "^3.4.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "changelogen": "^0.6.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "golar": "^0.1.10",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "undici": "^8.10.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.22.0"
}
